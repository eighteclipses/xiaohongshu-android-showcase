<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="0dp"
    android:paddingEnd="0dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground"
    android:minHeight="52dp">
    <TextView
        android:id="@+id/hotspotNumber"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:text="1"
        android:textSize="14sp"
        android:textColor="@color/xhs_red"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/bg_polish_field" />
    <TextView
        android:id="@+id/hotspotTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="热点标题"
        android:textSize="14sp"
        android:textColor="@color/polish_ink"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toEndOf="@id/hotspotNumber"
        app:layout_constraintEnd_toStartOf="@id/hotspotViews"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="10dp" />
    <TextView
        android:id="@+id/hotspotViews"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="981.7万"
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>