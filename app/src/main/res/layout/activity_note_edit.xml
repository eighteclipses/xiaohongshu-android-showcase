<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/polish_canvas"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical"
        android:background="@color/polish_canvas"
        android:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:id="@+id/backButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/icon_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back_button"
            android:padding="10dp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="发布笔记"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/polish_ink"
            android:paddingStart="8dp" />
        <TextView
            android:id="@+id/previewButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/preview"
            android:textColor="@color/xhs_red"
            android:textSize="14sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_polish_surface" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="20dp">
            <LinearLayout
                android:id="@+id/aiNoteButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="80dp"
                android:layout_marginBottom="16dp"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:background="@drawable/bg_polish_ai"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="AI 笔记助手，生成标题、正文和话题">
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_polish_sparkle"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="14dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="让灵感，变成好笔记"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/polish_violet" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="AI 帮你整理标题、正文和话题"
                        android:textSize="12sp"
                        android:textColor="@color/polish_muted"
                        android:layout_marginTop="5dp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_polish_chevron"
                    android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_polish_surface"
                android:layout_marginBottom="16dp">
                <HorizontalScrollView
                    android:id="@+id/imageScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/imageContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <FrameLayout
                            android:id="@+id/addImageButton"
                            android:layout_width="88dp"
                            android:layout_height="88dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_polish_field"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/icon_plus"
                                android:layout_gravity="center"
                                android:tint="@color/polish_muted"
                                android:layout_marginBottom="18dp" />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom"
                                android:layout_marginBottom="13dp"
                                android:gravity="center"
                                android:text="添加图片"
                                android:textSize="11sp"
                                android:textColor="@color/polish_muted" />
                        </FrameLayout>
                    </LinearLayout>
                </HorizontalScrollView>
                <TextView
                    android:id="@+id/titleHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="笔记内容"
                    android:textColor="@color/polish_muted"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />
                <EditText
                    android:id="@+id/titleInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="给这篇笔记起个标题"
                    android:textColor="@color/polish_ink"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="22sp"
                    android:background="@android:color/transparent"
                    android:paddingBottom="12dp"
                    android:inputType="text"
                    android:maxLines="2"
                    android:fontFamily="sans-serif-medium"
                    android:paddingTop="8dp" />
                <TextView
                    android:id="@+id/contentHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/add_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_14"
                    android:visibility="gone" />
                <EditText
                    android:id="@+id/contentInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="130dp"
                    android:gravity="top|start"
                    android:hint="分享此刻的想法、经验与故事…"
                    android:textColor="@color/polish_ink"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="15sp"
                    android:background="@android:color/transparent"
                    android:inputType="textCapSentences|textMultiLine"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:lineSpacingExtra="4dp" />
                <TextView android:id="@+id/moderationStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#A55D14" android:background="#FFF5DF" android:padding="12dp" android:textSize="13sp" android:visibility="gone" />
<TextView
                    android:id="@+id/aiNoteDisclosure"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="已采用 AI 辅助内容，请核实后发布"
                    android:textColor="@color/polish_violet"
                    android:visibility="gone"
                    android:textSize="11sp"
                    android:paddingTop="8dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_polish_surface">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="为笔记添加更多信息"
                    android:textSize="13sp"
                    android:textColor="@color/polish_muted" />
                <HorizontalScrollView
                    android:id="@+id/topicScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/topicContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:minHeight="40dp"
                        android:gravity="center_vertical" />
                </HorizontalScrollView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="8dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="@drawable/bg_polish_field">
                    <LinearLayout
                        android:id="@+id/topicActionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/icon_hashtag"
                            android:tint="@color/text_primary" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/topic"
                            android:textSize="@dimen/text_size_12"
                            android:textColor="@color/text_primary"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/userActionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp">
                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:text="@string/aite"
                            android:textSize="@dimen/text_size_18"
                            android:textColor="@color/text_primary"
                            android:gravity="center" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/user"
                            android:textSize="@dimen/text_size_12"
                            android:textColor="@color/text_primary"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/voteActionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/icon_chart"
                            android:tint="@color/text_primary" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/vote"
                            android:textSize="@dimen/text_size_12"
                            android:textColor="@color/text_primary"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/longTextActionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/icon_long_article"
                            android:tint="@color/text_primary" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/long_text"
                            android:textSize="@dimen/text_size_12"
                            android:textColor="@color/text_primary"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/locationSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/mark_location"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_16" />
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/icon_return"
                        android:rotation="180"
                        android:tint="@color/text_secondary" />
                </LinearLayout>
                <HorizontalScrollView
                    android:id="@+id/locationScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/locationContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:minHeight="40dp"
                        android:gravity="center_vertical" />
                </HorizontalScrollView>
                <LinearLayout
                    android:id="@+id/visibilitySection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/icon_lock"
                        android:tint="@color/text_secondary"
                        android:layout_marginEnd="8dp" />
                    <TextView
                        android:id="@+id/visibilityText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/public_visible"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_16" />
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/icon_return"
                        android:rotation="180"
                        android:tint="@color/text_secondary" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/addComponentSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/icon_component"
                        android:tint="@color/text_secondary"
                        android:layout_marginEnd="8dp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/add_component"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_16" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/can_add_files"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_12"
                        android:layout_marginEnd="8dp" />
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/icon_return"
                        android:rotation="180"
                        android:tint="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical"
        android:elevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:id="@+id/settingsButton"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/icon_setting"
                android:tint="@color/text_primary" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings"
                android:textSize="@dimen/text_size_12"
                android:textColor="@color/text_primary"
                android:layout_marginTop="4dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/saveDraftButton"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/icon_save"
                android:tint="@color/text_primary" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/save_draft"
                android:textSize="@dimen/text_size_12"
                android:textColor="@color/text_primary"
                android:layout_marginTop="4dp" />
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/publishButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/publish_note"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_16"
            android:textStyle="bold"
            android:background="@drawable/bg_polish_primary"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:minHeight="48dp"
            android:minWidth="120dp"
            android:backgroundTint="@null"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            app:backgroundTint="@null" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>