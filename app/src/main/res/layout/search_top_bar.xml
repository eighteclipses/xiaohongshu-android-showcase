<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="16dp"
    android:background="@color/polish_canvas">
    <ImageView
        android:id="@+id/backButton"
        style="@style/PolishIconAction"
        android:src="@drawable/icon_back"
        android:contentDescription="返回" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:background="@drawable/bg_polish_surface"
        android:paddingStart="12dp"
        android:paddingEnd="10dp">
        <ImageView
            android:id="@+id/searchIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/icon_search_small"
            android:tint="@color/polish_muted"
            android:importantForAccessibility="no" />
        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:hint="搜索笔记、用户"
            android:textColorHint="@color/polish_muted"
            android:textColor="@color/polish_ink"
            android:textSize="14sp"
            android:singleLine="true"
            android:imeOptions="actionSearch" />
    </LinearLayout>
    <TextView
        android:id="@+id/searchButton"
        android:layout_width="60dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:text="搜索"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:background="@drawable/bg_polish_primary"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>