<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:name=".app.AppApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/icon_logo"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Xiaohongshu"
        tools:targetApi="31">

        <!-- 登录页作为启动页 -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 主页面 -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Xiaohongshu"/>

        <!-- 其他页面 -->
        <activity android:name=".ui.publish.NoteEditActivity" android:theme="@style/Theme.Xiaohongshu.Polished"/>
        <activity android:name=".ui.publish.WriteThoughtsActivity"/>
        <activity android:name=".ui.search.SearchActivity" android:theme="@style/Theme.Xiaohongshu.Polished"/>
        <activity android:name=".ui.search.SearchResultActivity" android:theme="@style/Theme.Xiaohongshu.Polished"/>
        <activity android:name=".activity.graphic.GraphicActivity" android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".activity.video.VideoActivity"/>
        <activity android:name=".activity.chat.ChatActivity" android:windowSoftInputMode="adjustResize"/>
        
        <!-- 购物相关页面 -->
        <activity android:name=".ui.goods.GoodsDetailActivity"/>
        <activity android:name=".ui.cart.ShoppingCartActivity"/>
        <activity android:name=".ui.order.OrderConfirmActivity"/>
        <activity android:name=".ui.order.OrderListActivity"/>
        <activity android:name=".ui.order.OrderDetailActivity"/>
        <activity android:name=".ui.order.AddressListActivity"/>
        <activity android:name=".ui.payment.PaymentActivity"/>
        
        <!-- 消息相关页面 -->
        <activity android:name=".ui.message.LikesAndCollectionsActivity"/>
        <activity android:name=".ui.message.NewFollowsActivity"/>
        <activity android:name=".ui.message.CommentsAndMentionsActivity"/>
        <activity android:name=".ui.profile.UserProfileActivity"/>
        
        <!-- 菜单功能页面 -->
        <activity android:name=".ui.discover.DiscoverFriendsActivity"/>
        <activity android:name=".ui.comments.MyCommentsActivity"/>
        <activity android:name=".ui.history.BrowsingHistoryActivity"/>
        <activity android:name=".ui.wallet.WalletActivity"/>
        <activity android:name=".ui.draft.LocalDraftActivity"/>
        <activity android:name=".ui.guidelines.CommunityGuidelinesActivity"/>
        <activity android:name=".ui.scan.ScanActivity"/>
        <activity android:name=".ui.help.HelpActivity"/>
        <activity android:name=".ui.settings.SettingsActivity" android:theme="@style/Theme.Xiaohongshu.Polished"/>
        <activity android:name=".ui.settings.BlacklistActivity"/>
        <activity android:name=".ui.mine.EditProfileActivity"/>
        <activity android:name=".ui.mine.FollowListActivity"/>
        <activity android:name=".ui.common.InfoActivity"/>
    </application>

</manifest>
