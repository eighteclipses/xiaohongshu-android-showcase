PORT=3001

# Public demo defaults to isolated JSON storage.
STORAGE=json
DATA_FILE=./data.json

# Replace these values before using the server outside a local demo.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-before-use

# MySQL is optional for the demo. Set STORAGE=mysql and fill these values when needed.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=xiaohongshu

# Optional AI writing assistant. Keep the key on the server only.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
